{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bitcoin_analyst;Username=postgres;Password=123456"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "RequestTimeoutMinutes": 60
  },
  "Gemini": {
    "ApiKey": ""
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatId": ""
  },
  "Alerts": {
    "WorkerEnabled": true,
    "PollSeconds": 60,
    "DefaultUserId": "default"
  },
  "KlinesIngestion": {
    "BackfillStartDate": "2020-01-01T00:00:00Z",
    "MaxRequestsPerCycle": 60,
    "MaxGapsPerTimeframe": 50
  },
  "Indexing": {
    "DefaultBatchSize": 5000,
    "CandlePatternBatchSize": 50000,
    "WindowVectorBatchSize": 50000,
    "VolumeStatsBatchSize": 50000,
    "TechnicalIndicatorsBatchSize": 50000,
    "PatternSequenceBatchSize": 50000,
    "MlFeatureBatchSize": 100000,
    "WindowDatasetBatchSize": 5000,
    "TechnicalIndicatorWarmupBars": 250,
    "MlDatasetWarmupBars": 500,
    "MlRebuildMaxSamplesPerWindowSize": 20000,
    "EnableParallelTimeframes": true,
    "MaxParallelTimeframes": 4,
    "KlineStreamChunkSize": 50000,
    "EnableStreamingIndexing": true,
    "MaxInMemoryKlines": 100000,
    "WindowVectorLookbackBars": 5000,
    "CandlePatternLookbackBars": 0,
    "VolumeStatsLookbackBars": 0,
    "PatternSequenceLookbackBars": 5000
  },
  "Rss": {
    "PollMinutes": 15,
    "Feeds": [
      {
        "Url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "Source": "CoinDesk"
      },
      {
        "Url": "https://cointelegraph.com/rss",
        "Source": "Cointelegraph"
      },
      {
        "Url": "https://decrypt.co/feed",
        "Source": "Decrypt"
      },
      {
        "Url": "https://www.theblock.co/rss.xml",
        "Source": "TheBlock"
      },
      {
        "Url": "https://bitcoinmagazine.com/.rss/full/",
        "Source": "BitcoinMagazine"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
